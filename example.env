# ── LLM ──────────────────────────────────────────────────────────────────────
# LLM_BACKEND es compartida por el Call Copilot en tiempo real y por el
# clasificador de video en batch (src/video/classifier.py,
# src/processing/session_processor.py) — no son variables separadas.
# Default en tiempo real si no está definida: gpt (ver src/core/config_defaults.py).
# El clasificador batch cae a "ollama" si no está definida.
LLM_BACKEND=gpt                        # gpt (default tiempo real) | claude | ollama

# OpenAI — requerido cuando LLM_BACKEND=gpt
OPENAI_API_KEY=sk-...

# Anthropic — requerido cuando LLM_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...

# Umbral de tokens para elegir entre nano y mini (default: 500)
# Debajo del umbral → gpt-5.4-nano / igual o encima → gpt-5.4-mini
LLM_TOKEN_THRESHOLD=500

# ── STT ──────────────────────────────────────────────────────────────────────
STT_BACKEND=deepgram                   # deepgram (default) | whisper_local — cambiar requiere reiniciar

# Deepgram — requerido cuando STT_BACKEND=deepgram
DEEPGRAM_API_KEY=...

# Whisper local — tamaño de modelo por uso. Si la variable específica no está
# definida, cada uso cae primero a WHISPER_MODEL (legado) y luego a su propio
# default. tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_MODEL_CALL=large-v3-turbo      # STT_BACKEND=whisper_local en llamadas — cambiar requiere reiniciar
WHISPER_MODEL_VIDEO=base               # transcriptor de video — se relee por job, no requiere reiniciar
# WHISPER_MODEL=large-v3-turbo         # legado — fallback para ambas si las de arriba no están definidas

# Milisegundos de silencio sostenido antes de que el VAD (Silero) dispare fin
# de turno (default: 2000). El valor correcto depende de cómo hablás vos y
# con quién — ajustar empíricamente. Rango válido: 100-5000. Cambiar
# requiere reiniciar (queda congelado en el singleton de _preload_models).
SILENCE_THRESHOLD_MS=2000

# Desactivar el LLM para ver solo el texto consolidado en consola (default: true)
LLM_ENABLED=true

# Archivo de log opcional para la TUI (si no está definida, solo se loguea a consola)
CALL_LOG=call_copilot.log

# Local LLM via Ollama (usado por el clasificador de video en batch cuando
# LLM_BACKEND=ollama; no aplica al Call Copilot en tiempo real)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b